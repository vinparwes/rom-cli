<resources>

    <style name="TextAppearance.Romcli.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextAppearance.Romcli.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextAppearance.Romcli.Label" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextAppearance.Romcli.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Widget.Theme.Romcli.MyView" parent="">
        <item name="android:background">@color/gray_400</item>
        <item name="exampleColor">@color/light_blue_400</item>
    </style>

    <style name="poseIntroductionContainer">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="statisticsFragmentButtonText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="statisticsFragmentButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">60dp</item>
        <item name="android:layout_marginRight">60dp</item>
        <item name="android:layout_marginBottom">20dp</item>
    </style>
</resources>