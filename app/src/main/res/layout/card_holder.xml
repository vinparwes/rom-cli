<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHolder"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="10dp"
            app:cardElevation="10dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:padding="10dp">

                <TextView
                    android:id="@+id/cardHolderDateView"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="2024-02-16"
                    android:textColor="@android:color/black"
                    android:textFontWeight="1000"
                    android:textSize="15dp"></TextView>

                <TextView
                    android:id="@+id/cardHolderPoseView"
                    android:layout_width="143dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="External Rotation"
                    android:textColor="@android:color/black"
                    android:textFontWeight="1000"
                    android:textSize="15dp"></TextView>

                <TextView
                    android:id="@+id/cardHolderRomView"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="Test"
                    android:textColor="@android:color/black"
                    android:textFontWeight="1000"
                    android:textSize="15dp"></TextView>

                <Button
                    android:id="@+id/romSessionEnterButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"

                    android:text="Show"></Button>

            </GridLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

</RelativeLayout>